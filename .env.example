APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Payments
###############################################################################
# Paystack is the primary gateway. Fill these in to take card payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave is the international fallback for the diaspora cards Paystack
# declines. The integration is complete and tested; it reports itself as
# "awaiting credentials" in the admin and is skipped when choosing a gateway
# until all three of these are set. Nothing else changes when they are.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

PAYMENTS_PRIMARY=paystack
PAYMENTS_FALLBACK=flutterwave

# Bank transfer, confirmed by staff from the admin.
PAYMENTS_BANK_TRANSFER_ENABLED=true
PAYMENTS_BANK_ACCOUNT_NAME=
PAYMENTS_BANK_ACCOUNT_NUMBER=
PAYMENTS_BANK_NAME=

###############################################################################
# Email
###############################################################################
# Postmark or SES, with SPF, DKIM and DMARC on the sending domain. Until then
# MAIL_MAILER=log writes every message to storage/logs, which is enough to
# read and review the templates.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="hello@dizzymali.com"
MAIL_FROM_NAME="DizzyMali"

###############################################################################
# WhatsApp - configured and on hold
###############################################################################
# The Cloud API driver is written and wired. Leave WHATSAPP_ENABLED=false and
# every WhatsApp notification is logged rather than sent, so the whole path
# stays exercised. To switch on: fill in the credentials, set the driver to
# cloud_api, and set enabled to true.
#
# To use a different provider instead, implement the WhatsAppDriver interface
# in app/Domain/Messaging and name it in config/notifications.php. No calling
# code changes.
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LOCALE=en

# Meta decides what your approved templates are called. Put those names here
# rather than editing code - the app only ever refers to the keys.
WHATSAPP_TPL_ORDER_SUBMITTED=dizzymali_order_submitted
WHATSAPP_TPL_PAYMENT_RECEIVED=dizzymali_payment_received
WHATSAPP_TPL_STAGE_CHANGED=dizzymali_stage_changed
WHATSAPP_TPL_PROGRESS_PHOTO=dizzymali_progress_photo
WHATSAPP_TPL_ORDER_SHIPPED=dizzymali_order_shipped

# Per-channel master switches.
NOTIFY_MAIL_ENABLED=true
NOTIFY_DATABASE_ENABLED=true

###############################################################################
# Media
###############################################################################
# Catalogue images are public; customer uploads (measurements, inspiration,
# progress photos) are private and served through an authorisation check.
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local

# Records without a photograph render a generated placeholder rather than a
# broken frame. Set MEDIA_PLACEHOLDER_BADGE=false before going live if any are
# still in place and you would rather not label them.
MEDIA_PLACEHOLDERS_ENABLED=true
MEDIA_PLACEHOLDER_BADGE=true

###############################################################################
# Foreign exchange
###############################################################################
# 'manual' means rates are whatever you set in Admin > Currencies, and
# `php artisan fx:refresh` does nothing. Point FX_ENDPOINT at a provider and
# schedule the command to refresh daily.
FX_DRIVER=manual
FX_ENDPOINT=
FX_KEY=
FX_DEFAULT_MARGIN_PERCENT=8
